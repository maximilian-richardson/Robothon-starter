<mujoco model="ff_master_guardian_scene">
  <include file="ff_master_ultra.xml"/>

  <statistic center="0 0 0.6" extent="1.6"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.25 0.25 0.25" specular="0.9 0.9 0.9"/>
    <rgba haze="0.12 0.2 0.3 1"/>
    <global azimuth="200" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0.02 0.04 0.08" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.32 0.34 0.38" rgb2="0.25 0.27 0.3" markrgb="1 1 1" width="400" height="400"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.15"/>
    <material name="red" rgba="0.85 0.2 0.15 1"/>
    <material name="orange" rgba="0.95 0.55 0.1 1"/>
    <material name="blue" rgba="0.2 0.45 0.9 1"/>
    <material name="dark" rgba="0.15 0.16 0.18 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Arena props: a ring of pillars + cones (visual interest) -->
    <body name="prop_pillar_1" pos="1.1 -0.9 0">
      <geom type="cylinder" size="0.07 0.30" pos="0 0 0.30" material="blue"/>
    </body>
    <body name="prop_pillar_2" pos="1.1 0.9 0">
      <geom type="cylinder" size="0.07 0.30" pos="0 0 0.30" material="blue"/>
    </body>
    <body name="prop_cone_1" pos="1.45 0 0">
      <geom type="cylinder" size="0.09 0.16" pos="0 0 0.16" material="orange"/>
    </body>
    <body name="prop_pillar_3" pos="-0.9 -1.05 0">
      <geom type="cylinder" size="0.07 0.30" pos="0 0 0.30" material="dark"/>
    </body>
    <body name="prop_pillar_4" pos="-0.9 1.05 0">
      <geom type="cylinder" size="0.07 0.30" pos="0 0 0.30" material="dark"/>
    </body>
    <body name="prop_cone_2" pos="-1.35 0 0">
      <geom type="cylinder" size="0.09 0.16" pos="0 0 0.16" material="red"/>
    </body>

    <!-- Onboard camera on the head (views along +x = robot facing) -->
  </worldbody>
</mujoco>
